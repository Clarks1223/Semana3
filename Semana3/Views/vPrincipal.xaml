<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Semana3.Views.vPrincipal"
             NavigationPage.HasNavigationBar="False"
             Title="Principal">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1B1464" Offset="0.0" />
                <GradientStop Color="#512BD4" Offset="0.55" />
                <GradientStop Color="#8E5CF0" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Fill="#22FFFFFF" WidthRequest="260" HeightRequest="260"
                 HorizontalOptions="End" VerticalOptions="Start" Margin="0,-90,-90,0" />

        <VerticalStackLayout Padding="24" Spacing="24" VerticalOptions="Center" MaximumWidthRequest="440">
            <Label Text="Sesión iniciada" TextColor="#D9CCFF" FontSize="15" HorizontalTextAlignment="Center" />
            <Label x:Name="lblBienvenida" TextColor="White" FontSize="32" FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   SemanticProperties.HeadingLevel="Level1" />

            <Border BackgroundColor="White" StrokeThickness="0" Padding="24">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="28" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#1B1464" Opacity="0.35" Radius="30" Offset="0,14" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="18">
                    <Label Text="Vista principal" TextColor="#212121" FontSize="20" FontAttributes="Bold" />
                    <Label Text="Aquí irá el contenido de tu aplicación." TextColor="#6E6E6E" FontSize="15" />
                    <Button x:Name="btnCerrarSesion" Text="Cerrar sesión"
                            BackgroundColor="#512BD4" TextColor="White"
                            FontAttributes="Bold" FontSize="16"
                            HeightRequest="54" CornerRadius="16"
                            Clicked="btnCerrarSesion_Clicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
