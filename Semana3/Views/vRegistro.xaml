<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Semana3.Views.vRegistro"
             NavigationPage.HasNavigationBar="False"
             Title="Registro">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1B1464" Offset="0.0" />
                <GradientStop Color="#512BD4" Offset="0.55" />
                <GradientStop Color="#8E5CF0" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <Ellipse Fill="#22FFFFFF" WidthRequest="260" HeightRequest="260"
                 HorizontalOptions="End" VerticalOptions="Start" Margin="0,-90,-90,0" />
        <Ellipse Fill="#14FFFFFF" WidthRequest="320" HeightRequest="320"
                 HorizontalOptions="Start" VerticalOptions="End" Margin="-120,0,0,-120" />

        <ScrollView VerticalOptions="Center">
            <VerticalStackLayout Padding="24" Spacing="28" MaximumWidthRequest="440">

                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="Crear cuenta" TextColor="White" FontSize="32" FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Completa tus datos para registrarte" TextColor="#D9CCFF" FontSize="15"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Border BackgroundColor="White" StrokeThickness="0" Padding="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="28" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#1B1464" Opacity="0.35" Radius="30" Offset="0,14" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="18">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="USUARIO" TextColor="#6E6E6E" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.2" />
                            <Border BackgroundColor="#F3F0FC" StrokeThickness="0" Padding="16,0" HeightRequest="52">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Entry x:Name="txtUsuario" Placeholder="Elige un usuario"
                                       PlaceholderColor="#919191" TextColor="#212121"
                                       ReturnType="Next" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="CONTRASEÑA" TextColor="#6E6E6E" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.2" />
                            <Border BackgroundColor="#F3F0FC" StrokeThickness="0" Padding="16,0,8,0" HeightRequest="52">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                    <Entry x:Name="txtcontrasena" Placeholder="Crea una contraseña"
                                           PlaceholderColor="#919191" TextColor="#212121"
                                           IsPassword="True" ReturnType="Next" VerticalOptions="Center" />
                                    <Grid Grid.Column="1" WidthRequest="44" HeightRequest="44" VerticalOptions="Center"
                                          SemanticProperties.Description="Mostrar u ocultar contraseña">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnTogglePasswordTapped" />
                                        </Grid.GestureRecognizers>
                                        <Path Stroke="#512BD4" StrokeThickness="2" StrokeLineCap="Round" StrokeLineJoin="Round"
                                              Aspect="Uniform" WidthRequest="24" HeightRequest="24"
                                              HorizontalOptions="Center" VerticalOptions="Center"
                                              Data="M1,12 C4,6 8,4 12,4 C16,4 20,6 23,12 C20,18 16,20 12,20 C8,20 4,18 1,12 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 Z" />
                                        <Line x:Name="EyeSlash" X1="0" Y1="24" X2="24" Y2="0"
                                              Stroke="#512BD4" StrokeThickness="2" StrokeLineCap="Round"
                                              WidthRequest="22" HeightRequest="22"
                                              HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="CONFIRMAR CONTRASEÑA" TextColor="#6E6E6E" FontSize="11" FontAttributes="Bold" CharacterSpacing="1.2" />
                            <Border BackgroundColor="#F3F0FC" StrokeThickness="0" Padding="16,0" HeightRequest="52">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Entry x:Name="txtConfirmar" Placeholder="Repite la contraseña"
                                       PlaceholderColor="#919191" TextColor="#212121"
                                       IsPassword="True" ReturnType="Done" VerticalOptions="Center"
                                       Completed="btnRegistrar_Clicked" />
                            </Border>
                        </VerticalStackLayout>

                        <Button x:Name="btnRegistrar" Text="Registrarme"
                                BackgroundColor="#512BD4" TextColor="White"
                                FontAttributes="Bold" FontSize="16"
                                HeightRequest="54" CornerRadius="16"
                                Clicked="btnRegistrar_Clicked" />

                        <Button x:Name="btnVolver" Text="Volver al login"
                                BackgroundColor="Transparent" TextColor="#512BD4"
                                BorderColor="#512BD4" BorderWidth="1.5"
                                FontAttributes="Bold" FontSize="16"
                                HeightRequest="54" CornerRadius="16"
                                Clicked="btnVolver_Clicked" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
